# Copy this file to .env and replace the placeholder values with your Neon credentials.
# Keep .env private and never commit it.
ConnectionStrings__DefaultConnection=Host=YOUR_NEON_HOST;Port=5432;Database=neondb;Username=YOUR_NEON_USERNAME;Password=YOUR_NEON_PASSWORD;SSL Mode=Require;Trust Server Certificate=true
ASPNETCORE_ENVIRONMENT=Development
