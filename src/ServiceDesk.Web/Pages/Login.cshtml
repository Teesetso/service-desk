@page
@model ServiceDesk.Web.Pages.LoginModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign in - Service Desk</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="login-page">
    <main class="login-card">
        <div class="brand login-brand"><span class="brand-mark">SD</span><span class="brand-name">Service<span>Desk</span></span></div>
        <h1>Sign in</h1>
        <p class="muted">Choose the workspace for your role.</p>
        <div asp-validation-summary="All"></div>
        <form method="post">
            <label asp-for="Username">Username</label>
            <input asp-for="Username" autocomplete="username" required />
            <label asp-for="Password">Password</label>
            <input asp-for="Password" type="password" autocomplete="current-password" required />
            <button type="submit">Sign in</button>
        </form>
        <p class="login-help">Demo accounts: <strong>client</strong>, <strong>agent</strong>, and <strong>admin</strong>.</p>
    </main>
</body>
</html>
